# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Editors / OS
.vscode/
.idea/
.DS_Store
*.swp
*.bak*
.cache/

# Build outputs (host C build, iverilog/Verilator/Yosys scratch)
build/
obj_dir/
